<ltml>
  <page units="in" layout="absolute" grid="0.25in">
    <label font.size="20" font.weight="Bold" left="0.75" top="0.6">Relative Layout</label>
    <p left="0.75" top="1.0" width="6.6">Use layout="relative" when a container should provide its own coordinate system for overlays, callouts, and anchored badges.</p>

    <div left="0.75" top="1.6" width="6.4" height="3.2" border="dashed" padding="0.15in" layout="relative">
      <label font.weight="Bold" left="0.1" top="0.08">Container-local coordinates</label>
      <label left="0.2" top="0.45" border="thin" padding="3pt">left="0.2" top="0.45"</label>

      <rect left="0.25" top="1.0" width="1.35" height="0.75" fill="LightBlue" border="thin" />
      <label left="0.33" top="1.25">Explicit left/top</label>

      <label left="4.2" top="0.45" border="thin" padding="3pt">Anchored from right/bottom</label>
      <rect right="-0.3" top="1.05" width="1.25" height="0.7" fill="Gold" border="thin" />
      <label right="-0.4" top="1.3">right="0.3"</label>

      <rect left="2.2" top="0.8" width="35%" height="40%" fill="PaleGreen" border="thin" />
      <label left="2.3" top="1.17">width="35%" height="40%"</label>

      <label left="3.8" top="2.05" width="2.5" border="thin" fill="MistyRose" padding="3pt">Sized by left, right, top, bottom</label>
    </div>

    <div left="0.75" top="5.0" width="3.9" height="1.9" border="dotted" padding="0.15in">
      <label>Default vbox container with a positioned child.</label>
      <br/>
      <p width="2.0">Positional attrs without an explicit position still opt a child into relative placement.</p>
      <rect left="2.45" top="0.65" width="1.4" height="0.8" fill="LightCoral" border="thin" />
      <label left="2.58" top="0.96">Implicit relative</label>
    </div>

    <div left="4.95" top="5.0" width="2.2" height="1.9" border="dotted" layout="relative">
      <label font.weight="Bold" left="0.1" top="0.1">Page-scope pattern</label>
      <p left="0.1" top="0.42" width="1.7">A page can also use relative coordinates when you want page-local positioning.</p>
      <rect left="0.2" bottom="-0.2" width="0.95" height="0.45" fill="Lavender" border="thin" />
    </div>
  </page>
</ltml>
