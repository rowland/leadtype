<ltml page-size="letter">
  <pen id="pill-border" kind="linear-gradient" width="5pt"
       x0="0%" y0="50%" x1="100%" y1="50%"
       stops="0:#ef5148,1:#4f93ad" cap="round_cap" />
  <pen id="radial-outline" kind="radial-gradient" width="3pt"
       x0="50%" y0="50%" r0="0%" x1="50%" y1="50%" r1="60%"
       stops="0:Gold,1:MediumVioletRed" />
  <brush id="soft-panel" color="#fbfbfb" />
  <page margin="0.55in" layout.vpadding="0.55in">
    <label width="100%"
           border="pill-border" fill="soft-panel" corners="50%"
           padding="12pt" text-align="center" text-valign="middle"
           font.size="28pt" font.weight="Bold">Headline Wanted</label>
    <line width="6.3in" height="0.25in" align-self="center"
          style="pill-border" style.width="6pt" />
    <hbox height="1.25in" layout.hpadding="0.35in">
      <circle width="1.0in" height="1.0in" border="radial-outline" />
      <star width="1.0in" height="1.0in" points="5" r0="0.32in" border="pill-border" fill="Gold" />
    </hbox>
    <label width="5.6in" height="0.95in"
           border="pill-border" fill="soft-panel"
           corners="50% 14pt 0.18in 35% 8pt 8pt 25% 0.12in"
           padding="10pt" text-align="center" text-valign="middle"
           font.size="16pt" font.weight="Bold">
      8-value corners: mixed units and percentages
    </label>
  </page>
</ltml>
