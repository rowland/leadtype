<ltml>
  <pen id="ring" width="0.6pt" color="#5b6470" />

  <page units="in" layout="absolute">
    <label left="0.7" top="0.45" font.size="19" font.weight="Bold">Radial Layout</label>
    <p left="0.7" top="0.82" width="6.2">A radial container behaves like a table wrapped around a circle. Some children below are explicit sectors, while direct labels and paragraphs are wrapped into implicit sectors at parse time.</p>

    <disc left="1.0" top="1.55" width="5.6" height="5.6" rows="3" angles="0,40,85,130,180,230,285,330,360" base-angle="-90" r0="0.8">
      <sector colspan="2" fill="AliceBlue" border="ring" padding="0.08" text-align="center" font.size="9" font.weight="Bold">Auto below midline</sector>
      <p colspan="3" padding="0.08" font.size="8.5">This paragraph is a direct child of the radial container, so LTML wraps it in an implicit sector and shapes its lines to the changing width of the wedge.</p>
      <sector angle="0" fill="Cornsilk" border="ring"><label font.weight="Bold">01</label></sector>
      <label angle="0" font.weight="Bold">02</label>
      <sector facing="upside-down" fill="LavenderBlush" border="ring" padding="0.08">Facing override</sector>

      <sector rowspan="2" colspan="3" fill="HoneyDew" border="ring" padding="0.08">
        <p style.text-align="center">Merged sectors can host longer copy. This paragraph uses variable line widths that follow the sector instead of a rectangular frame.</p>
      </sector>
      <label angle="0" font.weight="Bold" font.size="16">03</label>
      <sector colspan="2" fill="MistyRose" border="ring">
        <label position="relative" origin-x="start" origin-y="inner" left="0.05" top="0.02" font.size="7">start / inner</label>
        <label position="relative" origin-x="end" origin-y="outer" right="-0.05" bottom="-0.02" font.size="7">end / outer</label>
      </sector>
      <p colspan="2" padding="0.08" font.size="8">Another implicit sector paragraph keeps ordinary LTML widgets but inherits sector geometry from the wrapper.</p>

      <sector colspan="2" fill="Lavender" border="ring" text-align="center" padding="0.08" font.size="9" font.weight="Bold">Auto above midline</sector>
      <label angle="0" font.weight="Bold">04</label>
      <sector colspan="2" fill="LightYellow" border="ring" padding="0.08">
        <p style.text-align="center">Explicit sectors can hold nested paragraphs, labels, and positioned children.</p>
      </sector>
    </disc>
  </page>
</ltml>
