<ltml>
  <pen id="ring" width="0.6pt" color="#5b6470" />

  <page units="in" layout="absolute">
    <label left="0.7" top="0.45" font.size="19" font.weight="Bold">Radial Out Layout</label>
    <p left="0.7" top="0.82" width="6.2">This variant starts at the center: row 0 is the innermost track, and each new row grows outward.</p>

    <div left="1.0" top="1.55" width="5.6" height="5.6" layout="radial-out" rows="3" cols="6" base-angle="-90" r0="0.75" font.size="10">
      <sector fill="Lavender" border="ring" font.weight="Bold"><label>Cat</label></sector>
      <sector fill="Lavender" border="ring" font.weight="Bold"><label>Dog</label></sector>
      <sector fill="Lavender" border="ring" font.weight="Bold"><label>Fox</label></sector>
      <sector fill="Lavender" border="ring" font.weight="Bold"><label>Hare</label></sector>
      <sector fill="Lavender" border="ring" font.weight="Bold"><label>Owl</label></sector>
      <sector fill="Lavender" border="ring" font.weight="Bold"><label>Lynx</label></sector>

      <sector fill="HoneyDew" border="ring" font.weight="Bold"><label>Otter</label></sector>
      <sector fill="HoneyDew" border="ring" font.weight="Bold"><label>Panda</label></sector>
      <sector fill="HoneyDew" border="ring" font.weight="Bold"><label>Quail</label></sector>
      <sector fill="HoneyDew" border="ring" font.weight="Bold"><label>Raven</label></sector>
      <sector fill="HoneyDew" border="ring" font.weight="Bold"><label>Seal</label></sector>
      <sector fill="HoneyDew" border="ring" font.weight="Bold"><label>Tiger</label></sector>

      <sector fill="Cornsilk" border="ring" font.weight="Bold"><label>Badger</label></sector>
      <sector fill="Cornsilk" border="ring" font.weight="Bold"><label>Falcon</label></sector>
      <sector fill="Cornsilk" border="ring" font.weight="Bold"><label>Jaguar</label></sector>
      <sector fill="Cornsilk" border="ring" font.weight="Bold"><label>Koala</label></sector>
      <sector fill="Cornsilk" border="ring" font.weight="Bold"><label>Turtle</label></sector>
      <sector fill="Cornsilk" border="ring" font.weight="Bold"><label>Walrus</label></sector>
    </div>
  </page>
</ltml>
