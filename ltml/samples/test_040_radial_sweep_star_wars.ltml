<ltml>
  <pen id="ring" width="0.6pt" color="#5b6470" />
  <define id="h1" tag="label" font.size="19" font.weight="Bold" />
  <style>
    label.subtitle { align-self: center; font.size: 12; font.weight: Bold; }
    sector { border: ring; font.weight: Bold; }
    sector.1 { fill: Lavender; }
    sector.2 { fill: HoneyDew; }
    sector.3 { fill: Cornsilk; }
    disc { layout: radial-out; rows: 3; cols: 6; base-angle: 180; r0: 0.6; font.size: 8.5; height: 4.2; align-self: center; }
  </style>

  <page units="in" margin="0.5in" layout="vbox" layout.vpadding="9pt">
    <h1>Radial Sweep Comparison</h1>
    <p>These two radial-out wheels use the same source-order Star Wars names. Only the sweep direction changes.</p>

    <label class="subtitle">Sweep = ccw</label>
    <disc>
      <sector class="1"><label>Luke</label></sector>
      <sector class="1"><label>Leia</label></sector>
      <sector class="1"><label>Han</label></sector>
      <sector class="1"><label>Chewie</label></sector>
      <sector class="1"><label>Yoda</label></sector>
      <sector class="1"><label>Vader</label></sector>

      <sector class="2"><label>R2-D2</label></sector>
      <sector class="2"><label>C-3PO</label></sector>
      <sector class="2"><label>Rey</label></sector>
      <sector class="2"><label>Finn</label></sector>
      <sector class="2"><label>Poe</label></sector>
      <sector class="2"><label>BB-8</label></sector>

      <sector class="3"><label>Lando</label></sector>
      <sector class="3"><label>Jyn</label></sector>
      <sector class="3"><label>Cassian</label></sector>
      <sector class="3"><label>Grogu</label></sector>
      <sector class="3"><label>Ahsoka</label></sector>
      <sector class="3"><label>Mando</label></sector>
    </disc>

    <label class="subtitle">Sweep = cw</label>
    <disc sweep="cw">
      <sector class="1"><label>Luke</label></sector>
      <sector class="1"><label>Leia</label></sector>
      <sector class="1"><label>Han</label></sector>
      <sector class="1"><label>Chewie</label></sector>
      <sector class="1"><label>Yoda</label></sector>
      <sector class="1"><label>Vader</label></sector>

      <sector class="2"><label>R2-D2</label></sector>
      <sector class="2"><label>C-3PO</label></sector>
      <sector class="2"><label>Rey</label></sector>
      <sector class="2"><label>Finn</label></sector>
      <sector class="2"><label>Poe</label></sector>
      <sector class="2"><label>BB-8</label></sector>

      <sector class="3"><label>Lando</label></sector>
      <sector class="3"><label>Jyn</label></sector>
      <sector class="3"><label>Cassian</label></sector>
      <sector class="3"><label>Grogu</label></sector>
      <sector class="3"><label>Ahsoka</label></sector>
      <sector class="3"><label>Mando</label></sector>
    </disc>
  </page>
</ltml>
